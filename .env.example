# Copy this file to .env and fill in your Firebase and EmailJS credentials

# ─── Firebase ───────────────────────────────────────────────────────────────
# Find these in Firebase Console → Project Settings → General → Your apps
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ─── EmailJS ─────────────────────────────────────────────────────────────────
# Find these in EmailJS Dashboard → Account → API Keys / Email Services
VITE_EMAILJS_SERVICE_ID=your-service-id
VITE_EMAILJS_TEMPLATE_ID=your-invite-template-id
VITE_EMAILJS_PUBLIC_KEY=your-public-key

# EmailJS template for deal workflow alerts
VITE_EMAILJS_WORKFLOW_TEMPLATE_ID=your-workflow-template-id
